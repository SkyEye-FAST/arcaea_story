play "ominous_swell_catastrophe.ogg" 0.8

move "catastrophe/cat_6_4_B.jpg" 0:-200 20 sineout
move "catastrophe/cat_6_4_A.jpg" 0:-200 20 sineout
hide "5black.png" fade(6,linear)
wait 4


wait 5
play "heartbeat_loop.ogg" 0.6 loop
wait 2 clear
hide "catastrophe/cat_6_4_A.jpg" fade(5,sineout)

say "Arcaea……
因为我，你要迎来灭顶之灾了。"

stop "heartbeat_loop.ogg" 5.0

wait 2
