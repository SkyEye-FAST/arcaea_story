show "catastrophe/card_A.png" 0.5:0.5 0.5:0.5 0.46:0.46 fade(0.1,linear) normal
show "black.png" 0.5:0.5 0.5:0.5 2000:960 fade(0,linear) normal
show "catastrophe/cat_1_4.jpg" 0.5:0.5 0.5:0.5 0.83:0.83 fade(0.1,linear) normal
show "2black.png" 0.5:0.5 0.5:0.5 2000:960 fade(0,linear) normal
show "catastrophe/cat_1_3.jpg" 0.5:1 0.5:1 0.7:0.7 fade(0.1,linear) normal
show "catastrophe/cat_1_2.jpg" 0.5:1 0.5:1 0.7:0.7 fade(0.1,linear) normal
show "4black.png" 0.5:0.5 0.5:0.5 2000:960 fade(0,linear) normal
show "catastrophe/cat_1_1.jpg" 0.5:0 0.5:0 0.7:0.7 fade(0.1,linear) normal
show "catastrophe/cat_1_1_b.jpg" 0.5:0 0.5:0 0.7:0.7 fade(0.1,linear) normal
move "catastrophe/cat_1_4.jpg" -19:0 0 linear
move "catastrophe/card_A.png" 0:45 0 linear
show "3black.png" 0.5:0.5 0.5:0.5 2000:960 fade(0,linear) normal

wait 1

play "ember_wind.ogg" 0 loop
volume "ember_wind.ogg" 0.5 3.0

say "「維塔。」"

move "catastrophe/cat_1_1.jpg" 0:-175 20 sineout
move "catastrophe/cat_1_1_b.jpg" 0:-175 20 sineout

play "breath.ogg" 3
hide "3black.png" fade(2,linear)
wait 2 clear
hide "catastrophe/cat_1_1_b.jpg" fade(6,linear)


say "「妳看起來真傻。」"

say "我讓她別繼續下去了。
「只有傻子才會罵別人傻。」我記得我是這麼說的。"

say "「妳在引用什麼名言警句麼？恕我直言，我不贊成。像我這種聰明但不招人喜歡的人也有自己最愛的格言：
如果自己做了蠢事，就不能怪別人說你蠢了。」"

say "我不禁笑了。"

hide "catastrophe/cat_1_1.jpg" fade(0.2,linear)

say "「維塔，把妳的五指張開，把手舉起來。」"

hide "4black.png" fade(0.4,linear)

say "我照做了。"

move "catastrophe/cat_1_2.jpg" 0:175 20 sineout
move "catastrophe/cat_1_3.jpg" 0:175 20 sineout

say "「現在，跟我掌心對掌心。」"

play "clothingRustleE.ogg" 0.1

say "我也照做了。"

play "thump.ogg" 3
hide "catastrophe/cat_1_2.jpg" fade(0.4,linear)

say "「或許妳是對的。或許妳曾有過的鏈接真的一去不復返了。」"

say "「但這也是一種聯繫，維塔。這也是人類會做的事。」"

say "我又不禁笑了。"

say "「當妳伸出手時—」"

play "loss_epilogue.ogg" 0.4
play "fading.ogg" 2
hide "catastrophe/cat_1_3.jpg" fade(0.05,linear)
hidetextbox
wait 6.0
hide "2black.png" fade(3.0,linear)
wait 4
wait 3 clear

say "…我會陪在妳身邊，幫妳再度站起來的。"

wait 1.0
hidetextbox
wait 1.0
hide "catastrophe/cat_1_4.jpg" fade(6.0,linear)
wait 4.0
hide "black.png" fade(1.0,linear)
wait 3.0
show "catastrophe/card_B.png" 0.5:0.5 0.5:0.5 0.46:0.46 fade(4.0,linear) normal
wait 0
move "catastrophe/card_B.png" 0:45 0 linear
wait 5.0
show "catastrophe/card_C.png" 0.5:0.5 0.5:0.5 0.46:0.46 fade(1.0,linear) normal
wait 0
move "catastrophe/card_C.png" 0:45 0 linear
wait 0.6

play "bell1.ogg" 0.5
play "bell2.ogg" 0.5

wait 7.4
hide "catastrophe/card_A.png" fade(5.0,linear)
hide "catastrophe/card_B.png" fade(5.0,linear)
hide "catastrophe/card_C.png" fade(5.0,linear)
stop "ember_wind.ogg" 20.0
wait 6.0
play "rain.ogg" 0 loop
volume "rain.ogg" 0.4 3.0
wait 2
wait 2 clear

say "維塔…她應該…
還藏著吧…？那就好…"


play "footstep_crunchy_loop.ogg" 0 loop
volume "footstep_crunchy_loop.ogg" 0.5 20.0
play "collapse.ogg" 1.0

say "我還想著自己至少能夠半跪著…
但力竭的我還是倒下了。"

show "nihil/nihil_3_cut2.jpg" 0.5:0.5 0.5:0.5 1.4:1.4 fade(2.0,linear) normal

say "我該做什麼才好…？
採取什麼樣的行動…我心裡期望的結果又是什麼？"


say "我所造成的損傷…
哈…不知道為何，我希望我受傷的時候不會流血。"

say "或許我右眼上生長的這朵花給了我一種我不只是普通人的錯覺嗎。
呵…誰知道呢，說不定忘卻那種人也會流血。"

hide "nihil/nihil_3_cut2.jpg" fade(0.2,linear)

stop "footstep_crunchy_loop.ogg" 0.1

say "她站在我面前，居高臨下地看著我。
…而我卻完全無法起身。"

say "她再度開口：
「她是藏起來了嗎？」"

say "「她」…？她…不…
不會的…她不可能說的是…？"

say "「真奇怪吶，我竟看不太清她在哪裡…
是妳動了什麼手腳嗎？ 」"

say "她俯下身來，一把按住我的頭顱，向上一提。
我的左眼與她的雙眼對視上。"

stop "rain.ogg" 5.0

say "「我已經夠直白了吧？」她說。"

play "clothingRustleA.ogg" 0.4

say "她的手指收緊，攥住了我一大把頭髮—我吃痛地瞇起眼睛。
她俯身貼近我，聲線冰冷。"

play "woosh.ogg" 1.0
show "nihil/nihil_3_cut3.jpg" 0.5:0.5 0.5:0.38 0.83:0.83 fade(1,linear) normal
wait 3.0 clear

say "「凡人—咲彌。
告訴我那孩子的位置。 」"

play "impactDeepTonal.ogg" 0.9
hide "nihil/nihil_3_cut3.jpg" fade(0.1,linear)

wait 5.0
