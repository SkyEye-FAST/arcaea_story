show "catastrophe/cat_3_5_1.jpg" 0.5:0 0.5:0 0.7:0.7 fade(0.1,sinout) normal
show "3black.png" 0.5:0.5 0.5:0.5 2000:960 fade(0.1,linear) normal
show "catastrophe/cat_3_5_1f.png" 0.5:0 0.5:0 0.7:0.7 fade(0.1,sinout) normal
show "4black.png" 0.5:0.5 0.5:0.5 2000:960 fade(0,linear) normal

move "catastrophe/cat_3_5_1.jpg" 0:-100 0 sineout
move "catastrophe/cat_3_5_1f.png" 0:-100 0 sineout
wait 0

